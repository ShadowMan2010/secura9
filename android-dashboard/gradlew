#!/bin/sh
APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
MAX_FD="maximum"
warn () { echo "$*"; }
die () { echo "$*"; exit 1; }
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ -f "$CLASSPATH" ]; then
    java -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
else
    GRADLE_CACHE="$HOME/.gradle/wrapper/dists/gradle-8.11.1-bin"
    GRADLE_DIR=$(ls -d "$GRADLE_CACHE"/*/gradle-8.11.1 2>/dev/null | head -1)
    if [ -n "$GRADLE_DIR" ] && [ -x "$GRADLE_DIR/bin/gradle" ]; then
        exec "$GRADLE_DIR/bin/gradle" "$@"
    fi
    die "Gradle wrapper jar not found. Run 'gradle wrapper' or open project in Android Studio first."
fi
